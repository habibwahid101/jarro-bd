# AWS region the backend resources live in.
VITE_AWS_REGION="us-east-1"

# Cognito Identity Pool ID — issues scoped guest/admin IAM credentials.
VITE_IDENTITY_POOL_ID="us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Cognito User Pool ID — admin accounts.
VITE_COGNITO_USER_POOL_ID="us-east-1_xxxxxxxxx"

# Cognito User Pool app client ID (must have no client secret — this is a
# browser SPA, USER_PASSWORD_AUTH must be enabled on the client).
VITE_COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# DynamoDB table names.
VITE_DDB_PRODUCTS_TABLE="JARRO-Products"
VITE_DDB_ORDERS_TABLE="JARRO-Orders"

# S3 bucket for admin-uploaded product photos (public read on the
# `products/` prefix only; writes require an admin Cognito session).
VITE_S3_PRODUCT_IMAGES_BUCKET="jarro-bd-product-images"
